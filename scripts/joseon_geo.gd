## (경도, 위도) -> 지도 단위(위도 1도 = 1). 왼쪽 위가 (0, 0).
static func project(ll: Vector2) -> Vector2:
	return Vector2((ll.x - LON0) * COS_LAT, LAT0 - ll.y)


static func town_ll(town_name: String) -> Vector2:
	for t in TOWNS:
		if t[0] == town_name:
			return Vector2(float(t[1]), float(t[2]))
	return Vector2(126.98, 37.55)


static func route_ll(stops: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for s in stops:
		if s is String:
			out.append(town_ll(s))
		else:
			out.append(s as Vector2)
	return out
